# Drizzle
# Replace with your DB credentials!
# Buat role dan database terlebih dahulu, lalu sesuaikan kredensialnya.
DATABASE_URL="postgres://batuankaler:password@localhost:5432/batuankaler_360"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Admin provisioning (development only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Upload storage
# local (default) atau s3 (AWS S3, Cloudflare R2, MinIO, dan S3-compatible lainnya)
STORAGE_DRIVER="local"

# Local storage (dipakai jika STORAGE_DRIVER=local)
UPLOAD_DIR="uploads"

# S3-compatible object storage (wajib jika STORAGE_DRIVER=s3)
# Contoh Cloudflare R2:
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="batuankaler-360"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_SESSION_TOKEN=""
# URL publik bucket, misalnya custom domain atau r2.dev:
# S3_PUBLIC_URL="https://cdn.example.com"
# S3_FORCE_PATH_STYLE="true"

# Docker runtime (optional)
BODY_SIZE_LIMIT="80M"
RUN_MIGRATIONS="true"
SEED_ON_START="false"
CREATE_ADMIN_ON_START="false"
